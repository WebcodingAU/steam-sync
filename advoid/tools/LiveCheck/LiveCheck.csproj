<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks AdVoid against the live sites over plain HTTP (no browser): see Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LiveCheck</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AdVoid\AdVoid.csproj" />
  </ItemGroup>

</Project>
