<Project Sdk="Microsoft.NET.Sdk">

  <!-- The ping helper: a small Windows service (NT AUTHORITY\LocalService) that watches which servers each process
       sends UDP and TCP traffic to, and tells the tray app over a named pipe. It ships inside the Gaming Enjoyer
       package; the tray app installs it into Program Files on request (one UAC prompt). See Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>GamingEnjoyerPing</AssemblyName>
    <RootNamespace>PingHelper</RootNamespace>
    <!-- Its own version: the tray app compares it with the installed copy to offer an update. Bump on any change. -->
    <Version>1.1.0</Version>
    <Product>Gaming Enjoyer</Product>
    <AssemblyTitle>Gaming Enjoyer ping helper</AssemblyTitle>
    <Company>gamingenjoyer.com</Company>
    <ApplicationIcon>..\SteamSync\app.ico</ApplicationIcon>
    <!-- One exe that runs from Program Files on its own, with no .NET install: self-contained, trimmed and compressed.
         Everything it calls is plain P/Invoke, so trimming is safe. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
